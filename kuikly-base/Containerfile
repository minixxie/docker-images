FROM --platform=$TARGETPLATFORM eclipse-temurin:21-jdk-jammy
ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDPLATFORM

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    unzip \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Android SDK (needed for shared module)
RUN mkdir -p /opt/android-sdk/cmdline-tools && \
    cd /tmp && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm cmdline-tools.zip

RUN yes | sdkmanager --licenses > /dev/null 2>&1 && \
    sdkmanager "platform-tools" \
               "platforms;android-34" \
               "platforms;android-35" \
               "build-tools;34.0.0" \
               "build-tools;35.0.0" \
               "ndk;25.2.9519653"

# Install Node.js for web build tools
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn

# Install Gradle
RUN wget -q https://services.gradle.org/distributions/gradle-8.12-bin.zip -O /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    ln -s /opt/gradle-8.12/bin/gradle /usr/local/bin/gradle && \
    rm /tmp/gradle.zip

# Set Gradle JVM args to increase memory
ENV GRADLE_OPTS="-Xmx4g -XX:MaxMetaspaceSize=1g"

WORKDIR /app

# Create a directory for putting android APK(s)
RUN mkdir -p /output
# Add this to your Containerfile:
# RUN cp /app/androidApp/build/outputs/apk/release/*.apk /output/ || true
# Then APK files will be in /output directory
# Use: docker cp <container>:/output ./local-output-dir

# Copy index.html to the distribution directory
RUN mkdir -p /app/shared/build/dist/js/productionExecutable/

################################################
# SAMPLE Containerfile.android:
################################################
# 
# COPY . .
# 
# # Generate gradle wrapper
# RUN gradle wrapper --gradle-version 8.5 --no-daemon
# 
# # Set Gradle JVM args to increase memory
# ENV GRADLE_OPTS="-Xmx4g -XX:MaxMetaspaceSize=1g"
# 
# RUN ./gradlew :androidApp:assembleRelease --no-daemon --stacktrace
# 
# # Create a directory for easy APK extraction
# RUN mkdir -p /output && \
#     cp /app/androidApp/build/outputs/apk/release/*.apk /output/ || true




################################################
# SAMPLE Containerfile.web:
################################################
# 
# COPY . .
# 
# # Generate gradle wrapper
# RUN gradle wrapper --gradle-version 8.5 --no-daemon
# 
# # Build web assets using Kotlin/JS
# RUN ./gradlew :shared:jsBrowserDistribution --no-daemon --stacktrace
# 
# # Copy index.html to the distribution directory
# COPY jsApp/index.html /app/shared/build/dist/js/productionExecutable/
# 
# FROM nginx:alpine
# 
# WORKDIR /usr/share/nginx/html
# 
# # Copy Kotlin/JS distribution output into nginx web root.
# COPY --from=builder /app/shared/build/dist/js/productionExecutable/ ./
# 
# EXPOSE 80
# 
# CMD ["nginx", "-g", "daemon off;"]
