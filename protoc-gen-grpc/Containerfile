#FROM openjdk:17-jdk-slim AS builder
FROM --platform=$TARGETPLATFORM eclipse-temurin:17-jdk AS builder
ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDPLATFORM

WORKDIR /workspace
# install small utilities
RUN apt-get update && apt-get install -y curl ca-certificates --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Download a prebuilt protoc-gen-grpc-java binary from Maven Central instead
# of building the whole grpc-java project. Select classifier from TARGETARCH.
ARG GRPC_JAVA_VERSION=1.81.0
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
  amd64|x86_64) classifier=linux-x86_64 ;; \
  arm64|aarch64) classifier=linux-aarch_64 ;; \
  ppc64le) classifier=linux-ppcle_64 ;; \
  s390x) classifier=linux-s390_64 ;; \
  *) classifier=linux-x86_64 ;; \
  esac && \
  echo "Downloading protoc-gen-grpc-java for ${classifier}" && \
  curl -fSL "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/${GRPC_JAVA_VERSION}/protoc-gen-grpc-java-${GRPC_JAVA_VERSION}-${classifier}.exe" -o /usr/local/bin/protoc-gen-grpc-java && \
  chmod +x /usr/local/bin/protoc-gen-grpc-java

FROM --platform=$TARGETPLATFORM golang:1.26.2
ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDPLATFORM

# copy launcher produced by gradle installDist
COPY --from=builder /usr/local/bin/protoc-gen-grpc-java /usr/local/bin/protoc-gen-grpc-java
RUN chmod +x /usr/local/bin/protoc-gen-grpc-java

ENV PROTOC_VER 34.1

RUN apt-get update && apt-get install -y curl ca-certificates unzip --no-install-recommends && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64|x86_64) url="https://github.com/google/protobuf/releases/download/v${PROTOC_VER}/protoc-${PROTOC_VER}-linux-x86_64.zip" ;; \
      arm64|aarch64) url="https://github.com/google/protobuf/releases/download/v${PROTOC_VER}/protoc-${PROTOC_VER}-linux-aarch_64.zip" ;; \
      *) echo >&2 "ERR: unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fSL -o /tmp/protoc.zip "${url}"

RUN mkdir -p /tmp/protoc && cd /tmp/protoc && unzip ../protoc.zip && tar czf /tmp/protoc.tar.gz *
RUN cd /usr && tar xzf /tmp/protoc.tar.gz

COPY --from=bufbuild/buf:1.69.0 /usr/local/bin/buf /usr/local/bin/buf

ADD ./scripts/install-protoc-plugins.sh /usr/local/bin/install-protoc-plugins.sh
ADD ./scripts/ci/api-linter.sh /usr/local/bin/api-linter.sh
RUN install-protoc-plugins.sh
